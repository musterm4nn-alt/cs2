<Project Sdk="Microsoft.NET.Sdk">
  <!-- Build: dotnet build -c Release  (needs a local Cities: Skylines II install; set CS2_MANAGED if it is elsewhere) -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <AssemblyName>CS2SimProbe</AssemblyName>
    <RootNamespace>CS2SimProbe</RootNamespace>
    <CS2_MANAGED Condition="'$(CS2_MANAGED)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Cities Skylines II\Cities2_Data\Managed</CS2_MANAGED>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Game"><HintPath>$(CS2_MANAGED)\Game.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Colossal.Core"><HintPath>$(CS2_MANAGED)\Colossal.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Colossal.Logging"><HintPath>$(CS2_MANAGED)\Colossal.Logging.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Colossal.IO.AssetDatabase"><HintPath>$(CS2_MANAGED)\Colossal.IO.AssetDatabase.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Colossal.Collections"><HintPath>$(CS2_MANAGED)\Colossal.Collections.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Colossal.Mathematics"><HintPath>$(CS2_MANAGED)\Colossal.Mathematics.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.Entities"><HintPath>$(CS2_MANAGED)\Unity.Entities.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.Collections"><HintPath>$(CS2_MANAGED)\Unity.Collections.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.Mathematics"><HintPath>$(CS2_MANAGED)\Unity.Mathematics.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.Burst"><HintPath>$(CS2_MANAGED)\Unity.Burst.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(CS2_MANAGED)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="netstandard"><HintPath>$(CS2_MANAGED)\netstandard.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
